{
  "datasets": [
    {
      "name": "daily",
      "displayName": "DEMO · Importe POS diario",
      "config": {
        "version": "1.1",
        "source": "workspace.astro_taco_demo.gold_daily_sales",
        "measures": [
          {
            "name": "reported_total",
            "expr": "SUM(reported_total)",
            "displayName": "Importe POS sintético"
          },
          {
            "name": "transactions",
            "expr": "SUM(transactions)",
            "displayName": "Tickets publicados"
          },
          {
            "name": "average_ticket",
            "expr": "SUM(reported_total) / NULLIF(SUM(transactions), 0)",
            "displayName": "Ticket promedio ponderado"
          }
        ],
        "dimensions": [
          {
            "name": "business_date",
            "expr": "business_date",
            "displayName": "Fecha"
          },
          {
            "name": "store_id",
            "expr": "store_id",
            "displayName": "Tienda"
          }
        ]
      }
    },
    {
      "name": "quality",
      "displayName": "DEMO · Calidad",
      "config": {
        "version": "1.1",
        "source": "workspace.astro_taco_demo.gold_quality_summary",
        "measures": [
          {
            "name": "source_rows",
            "expr": "SUM(source_rows)",
            "displayName": "Filas fuente"
          },
          {
            "name": "quarantined_rows",
            "expr": "SUM(quarantined_rows)",
            "displayName": "Filas en cuarentena"
          },
          {
            "name": "duplicate_candidate_rows",
            "expr": "SUM(duplicate_candidate_rows)",
            "displayName": "Filas duplicadas candidatas"
          }
        ]
      }
    },
    {
      "name": "menu",
      "displayName": "DEMO · Unidades por categoría",
      "config": {
        "version": "1.1",
        "source": "workspace.astro_taco_demo.gold_menu_performance",
        "measures": [
          {
            "name": "units",
            "expr": "SUM(units)",
            "displayName": "Unidades"
          }
        ],
        "dimensions": [
          {
            "name": "report_group",
            "expr": "report_group",
            "displayName": "Categoría"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "demo",
      "displayName": "DEMO · Datos sintéticos",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "counter_0",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "daily",
                  "fields": [
                    {
                      "name": "measure(reported_total)",
                      "expression": "MEASURE(`reported_total`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "DEMO · Importe POS"
              },
              "encodings": {
                "value": {
                  "fieldName": "measure(reported_total)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 4,
            "height": 2
          }
        },
